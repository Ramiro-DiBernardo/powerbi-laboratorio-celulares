    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Fechas",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0F2A44",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  El mes sale siempre de la fecha. La columna «Mes» no se usa: tiene «January», «enero», «ENERO», «c», «OCTA/»…",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Fechas en texto («28/05/2026», «21/1», «22-1») se interpretan; si falta el año se toma el de la fila anterior.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Año imposible (p. ej. 2023 en una hoja de 2026) se corrige con el año de la fila anterior; día/mes invertidos también.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Fila sin fecha: toma la fecha de la fila anterior de la misma hoja y queda marcada como «Imputada».",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
