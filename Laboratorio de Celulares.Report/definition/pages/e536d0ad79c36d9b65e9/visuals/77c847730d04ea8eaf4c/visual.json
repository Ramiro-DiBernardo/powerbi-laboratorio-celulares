    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Campos de proceso",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0F2A44",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Puesto, Estado y Negocio se homologan sin importar mayúsculas, tildes o espacios («sCRAP», «sin Reparar», «PENDIENTE »).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Valores en la columna equivocada (p. ej. «BBTI» como Estado) quedan como «No válido» y generan alerta.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  El técnico es el de la hoja (aunque la columna diga «Bruno Correa» y la hoja «Correa Bruno»).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Las observaciones se clasifican por palabras clave (pantalla, tapa, batería, placa…) tolerando errores («pantlla», «traslucido»).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#334155"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
