table 'Flujo laboratorio'
	lineageTag: 76ae84a3-7fc9-5f5f-83f6-f88284bb1c81

	column Fecha
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: e0024b78-9f2e-5557-9375-4e6371ad6477
		summarizeBy: none
		sourceColumn: Fecha

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column 'Alerta fecha'
		dataType: string
		lineageTag: 28021fa4-9740-5a86-a5f7-57a376fbae17
		summarizeBy: none
		sourceColumn: Alerta fecha

		annotation SummarizationSetBy = Automatic

	column Ingresos
		dataType: double
		formatString: #,0
		lineageTag: 072b33b5-5a1a-59fa-8969-f3942ee6f06e
		summarizeBy: sum
		sourceColumn: Ingresos

		annotation SummarizationSetBy = Automatic

	column Egresos
		dataType: double
		formatString: #,0
		lineageTag: 2a1ed6a6-fa0b-5eed-a60e-8a0bafa42c9c
		summarizeBy: sum
		sourceColumn: Egresos

		annotation SummarizationSetBy = Automatic

	column Reparados
		dataType: double
		formatString: #,0
		lineageTag: 204a0c19-ba5c-578c-8448-e75df5c94cc1
		summarizeBy: sum
		sourceColumn: Reparados

		annotation SummarizationSetBy = Automatic

	column Scrap
		dataType: double
		formatString: #,0
		lineageTag: d4cd4857-a5dd-5394-b7f1-cffe73f4e470
		summarizeBy: sum
		sourceColumn: Scrap

		annotation SummarizationSetBy = Automatic

	column 'Fila Excel'
		dataType: int64
		formatString: 0
		lineageTag: 173fafae-34a0-51b6-ba22-6f585826da4f
		summarizeBy: none
		sourceColumn: Fila Excel

		annotation SummarizationSetBy = Automatic

	partition 'Flujo laboratorio' = m
		mode: import
		source =
				let
				    // ---- funciones auxiliares (ver comentarios en cada una)
				    fxClave =
				        // Texto comparable: MAYÚSCULAS, sin tildes, sin espacios duros/saltos de línea y con espacios simples
				        (v as any) as nullable text =>
				        let
				            Texto =
				                if v = null then null
				                else if Value.Is(v, type number) then Number.ToText(v, "0", "en-US")
				                else if Value.Is(v, type date) or Value.Is(v, type datetime) then Date.ToText(Date.From(v), [Format = "dd/MM/yyyy"])
				                else Text.From(v),
				            Pares = {{"Á", "A"}, {"À", "A"}, {"Ä", "A"}, {"Â", "A"}, {"É", "E"}, {"È", "E"}, {"Ë", "E"}, {"Ê", "E"},
				                {"Í", "I"}, {"Ì", "I"}, {"Ï", "I"}, {"Î", "I"}, {"Ó", "O"}, {"Ò", "O"}, {"Ö", "O"}, {"Ô", "O"},
				                {"Ú", "U"}, {"Ù", "U"}, {"Ü", "U"}, {"Û", "U"}, {"Ñ", "N"}, {"Ç", "C"}},
				            Mayus = if Texto = null then null else Text.Upper(Texto),
				            SinTildes = if Mayus = null then null else List.Accumulate(Pares, Mayus, (s, p) => Text.Replace(s, p{0}, p{1})),
				            // separadores raros -> espacio; después se descarta todo lo que no sea ASCII imprimible
				            Espacios = if SinTildes = null then null
				                else Text.Combine(Text.SplitAny(SinTildes, "#(00A0)#(cr)#(lf)#(tab)"), " "),
				            Ascii = if Espacios = null then null else Text.Select(Espacios, {" ".."~"}),
				            Limpio = if Ascii = null then null else Text.Combine(List.Select(Text.Split(Ascii, " "), each _ <> ""), " ")
				        in
				            if Limpio = null or Limpio = "" then null else Limpio,
				    fxFecha =
				        // Interpreta una fecha cargada como fecha, número de serie de Excel o texto ("21/1", "22-1", "28/05/2026")
				        (v as any) as record =>
				        let
				            Vacio = [Fecha = null, Dia = null, Mes = null, Texto = false, Parcial = false, Ilegible = false],
				            Resultado =
				                if v = null then Vacio
				                else if Value.Is(v, type date) then Vacio & [Fecha = v]
				                else if Value.Is(v, type datetime) then Vacio & [Fecha = Date.From(v)]
				                else if Value.Is(v, type datetimezone) then Vacio & [Fecha = Date.From(DateTimeZone.RemoveZone(v))]
				                else if Value.Is(v, type number) then
				                    (if v >= 1 and v < 2958466 then Vacio & [Fecha = Date.From(v)] else Vacio & [Ilegible = true])
				                else
				                    let
				                        t = Text.Trim(Text.Replace(Text.From(v), "#(00A0)", " ")),
				                        Partes = List.Select(Text.SplitAny(t, "/-. "), each _ <> ""),
				                        Numeros = List.Transform(Partes, each try Number.From(_, "en-US") otherwise null),
				                        TodoNum = List.Count(Partes) >= 2 and List.Count(Partes) <= 3
				                            and List.NonNullCount(Numeros) = List.Count(Partes)
				                            and List.AllTrue(List.Transform(Partes, each Text.Length(_) <= 4)),
				                        D = if TodoNum then Numeros{0} else null,
				                        M = if TodoNum then Numeros{1} else null,
				                        A0 = if TodoNum and List.Count(Numeros) = 3 then Numeros{2} else null,
				                        A = if A0 = null then null else if A0 < 100 then 2000 + A0 else A0
				                    in
				                        if t = "" then Vacio
				                        else if TodoNum and A <> null then
				                            (try Vacio & [Fecha = #date(A, M, D), Texto = true] otherwise Vacio & [Ilegible = true, Texto = true])
				                        else if TodoNum and D >= 1 and D <= 31 and M >= 1 and M <= 12 then
				                            Vacio & [Dia = D, Mes = M, Parcial = true, Texto = true]
				                        else
				                            (try Vacio & [Fecha = Date.From(DateTime.FromText(t, [Culture = "es-AR"])), Texto = true]
				                             otherwise Vacio & [Ilegible = true, Texto = true])
				        in
				            Resultado,
				    fxResolverFecha =
				        // Decide la fecha final de una fila. "ref" es la última fecha válida de las filas anteriores de la misma hoja.
				        // Corrige: año mal tipeado (2023 en una hoja de 2026), día/mes invertidos, fecha sin año y fecha vacía.
				        (info as record, ref as nullable date, hoy as date, minimo as date) as record =>
				        let
				            AnioRef = if ref <> null then Date.Year(ref) else Date.Year(hoy),
				            Armar = (a as number, m as number, d as number) => try #date(a, m, d) otherwise null,
				            EnRango = (f) => f <> null and f >= minimo and f <= hoy,
				            Imputar = (motivo as text) => [Fecha = ref, Alerta = if ref <> null then motivo & " (se usó la fila anterior)" else "Sin fecha"],
				            f = info[Fecha],
				            Resultado =
				                if f <> null then
				                    if EnRango(f) then [Fecha = f, Alerta = if info[Texto] then "Fecha cargada como texto" else null]
				                    else
				                        let
				                            Invertida = if f > hoy then Armar(Date.Year(f), Date.Day(f), Date.Month(f)) else null,
				                            ConAnio = Armar(AnioRef, Date.Month(f), Date.Day(f))
				                        in
				                            if EnRango(Invertida) then [Fecha = Invertida, Alerta = "Fecha con día y mes invertidos"]
				                            else if EnRango(ConAnio) then [Fecha = ConAnio, Alerta = "Fecha con año corregido"]
				                            else Imputar("Fecha fuera de rango")
				                else if info[Parcial] then
				                    let
				                        c1 = Armar(AnioRef, info[Mes], info[Dia]),
				                        c2 = if EnRango(c1) then c1 else Armar(AnioRef - 1, info[Mes], info[Dia])
				                    in
				                        if EnRango(c2) then [Fecha = c2, Alerta = "Fecha sin año (año inferido)"] else Imputar("Fecha ilegible")
				                else if info[Ilegible] then Imputar("Fecha ilegible")
				                else Imputar("Fecha vacía")
				        in
				            Resultado,
				    fxFechasTabla =
				        // Agrega [Fecha], [Alerta fecha] y [Fecha directa] a una tabla en el orden de la hoja.
				        // Las filas sin fecha (o con fecha imposible) toman la última fecha válida de las filas anteriores.
				        (t as table, columna as text, hoy as date, minimo as date) as table =>
				        let
				            ConInfo = Table.AddColumn(t, "__Info", each fxFecha(Record.Field(_, columna))),
				            ConRef = Table.AddColumn(ConInfo, "__Ref", each
				                let f = [__Info][Fecha] in if f <> null and f >= minimo and f <= hoy then f else null),
				            Relleno = Table.FillDown(ConRef, {"__Ref"}),
				            ConRes = Table.AddColumn(Relleno, "__Res", each fxResolverFecha([__Info], [__Ref], hoy, minimo)),
				            ConFecha = Table.AddColumn(ConRes, "Fecha", each [__Res][Fecha], type nullable date),
				            ConAlerta = Table.AddColumn(ConFecha, "Alerta fecha", each [__Res][Alerta], type nullable text),
				            ConDirecta = Table.AddColumn(ConAlerta, "Fecha directa", each [__Info][Fecha] <> null, type logical)
				        in
				            Table.Buffer(Table.RemoveColumns(ConDirecta, {"__Info", "__Ref", "__Res"})),
				    fxEncabezado =
				        // Busca en las primeras 8 filas la fila de encabezados que contiene todas las claves pedidas
				        (datos as table, requeridas as list, prohibidas as list) as nullable record =>
				        let
				            Filas = List.Transform(Table.ToRows(Table.FirstN(datos, 8)), (f) => List.Transform(List.FirstN(f, 60), fxClave)),
				            Ok = List.Transform(Filas, (f) => List.ContainsAll(f, requeridas) and not List.ContainsAny(f, prohibidas)),
				            Pos = List.PositionOf(Ok, true)
				        in
				            if Pos < 0 then null else [Fila = Pos, Claves = Filas{Pos}],
				
				    // Hoja de ingresos/egresos diarios del laboratorio (encabezados "Ingresos Labo" y "Egresos Labo").
				    // Las fechas vienen como "20/1/2026", "21/1", "22-1" o con el año mal tipeado: se normalizan.
				    Hoy = Date.From(DateTime.LocalNow()),
				    Minimo = #date(Date.Year(Hoy) - 1, 1, 1),
				    Vacia = #table(type table [Fecha = nullable date, #"Alerta fecha" = nullable text, Ingresos = nullable number,
				        Egresos = nullable number, Reparados = nullable number, Scrap = nullable number, #"Fila Excel" = Int64.Type], {}),
				    Origen = Excel.Workbook((if Text.StartsWith(RutaExcel, "http") then Web.Contents(RutaExcel) else File.Contents(RutaExcel)), null, true),
				    Hojas = Table.SelectRows(Origen, each [Kind] = "Sheet"),
				    ConEnc = Table.AddColumn(Hojas, "Enc", each try fxEncabezado([Data], {"INGRESOS LABO", "EGRESOS LABO"}, {}) otherwise null),
				    Candidatas = Table.SelectRows(ConEnc, each [Enc] <> null),
				    Num = (v) => if v = null then null else if Value.Is(v, type number) then v
				        else try Number.From(Text.Trim(Text.From(v)), "es-AR") otherwise null,
				    Procesar = (datos as table, enc as record) as table =>
				        let
				            // en búfer: se usan en cada fila (sin búfer el motor las vuelve a calcular y tarda minutos)
				            H = List.Buffer(enc[Claves]),
				            Nombres = List.Buffer(Table.ColumnNames(datos)),
				            V = (r, k) => let p = List.PositionOf(H, k) in if p < 0 then null else Record.Field(r, Nombres{p}),
				            Cuerpo = Table.AddIndexColumn(Table.Skip(datos, enc[Fila] + 1), "__Fila", enc[Fila] + 2, 1, Int64.Type),
				            Filas = Table.FromRecords(List.Transform(Table.ToRecords(Cuerpo), (r) =>
				                [F = V(r, "FECHA"), Ingresos = Num(V(r, "INGRESOS LABO")), Egresos = Num(V(r, "EGRESOS LABO")),
				                 Reparados = Num(V(r, "REPARADO")), Scrap = Num(V(r, "SCRAP")), #"Fila Excel" = r[__Fila]]),
				                {"F", "Ingresos", "Egresos", "Reparados", "Scrap", "Fila Excel"}),
				            ConDatos = Table.SelectRows(Filas, each [Ingresos] <> null or [Egresos] <> null),
				            ConFecha = fxFechasTabla(ConDatos, "F", Hoy, Minimo),
				            ConRep = Table.ReplaceValue(ConFecha, each [Reparados], each
				                if [Reparados] = null and [Egresos] <> null then [Egresos] - ([Scrap] ?? 0) else [Reparados], Replacer.ReplaceValue, {"Reparados"})
				        in
				            Table.SelectColumns(ConRep, {"Fecha", "Alerta fecha", "Ingresos", "Egresos", "Reparados", "Scrap", "Fila Excel"}),
				    Resultado = if Table.IsEmpty(Candidatas) then Vacia
				        else Table.Combine(List.Transform(Table.ToRecords(Candidatas), each Procesar([Data], [Enc]))),
				    Tipos = Table.TransformColumnTypes(Resultado, {{"Fecha", type date}, {"Alerta fecha", type text}, {"Ingresos", type number},
				        {"Egresos", type number}, {"Reparados", type number}, {"Scrap", type number}, {"Fila Excel", Int64.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table

