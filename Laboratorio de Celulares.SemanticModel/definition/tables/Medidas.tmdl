	measure 'Color cumplimiento' =
			VAR _p = [Cumplimiento total]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ), "#B8C2CC", _p >= 1, "#1F9D63", _p >= 0.85, "#E8A317", "#D4533B" )
		displayFolder: Formato
		lineageTag: d97bdc13-29f0-54af-b38e-e748715e4b51

	measure 'Color reparabilidad' =
			VAR _p = [Reparabilidad]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ), "#B8C2CC", _p >= 0.6, "#1F9D63", _p >= 0.4, "#E8A317", "#D4533B" )
		displayFolder: Formato
		lineageTag: a3f3736b-3c4a-58d5-abeb-d01b8124decc

	measure 'Color fail post' =
			VAR _p = [% FAIL post reparación]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ), "#B8C2CC", _p <= 0.01, "#1F9D63", _p <= 0.03, "#E8A317", "#D4533B" )
		displayFolder: Formato
		lineageTag: 58778cd1-7c53-5377-b64a-a2ac313cbb78

	measure 'Color categoría' = SELECTEDVALUE ( 'Categorías falla'[Color], "#5B6B7A" )
		displayFolder: Formato
		lineageTag: 1f5752ef-340d-5278-81fe-f47becd9bf19

	measure 'Color calor puesto' =
			VAR _v = [Registros]
			VAR _m = MAXX ( CROSSJOIN ( ALLSELECTED ( 'Técnicos'[Técnico] ), ALLSELECTED ( Registros[Puesto] ) ), [Registros] )
			VAR _r = DIVIDE ( _v, _m )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v ), "#FFFFFF", _r >= 0.8, "#1D4ED8", _r >= 0.6, "#3B82F6", _r >= 0.4, "#7FB0FF", _r >= 0.2, "#BCD4FF", "#E6EEFF" )
		displayFolder: Formato
		lineageTag: 3bdd5b01-4b79-578e-9803-9b696cffa278

	measure 'Color texto calor puesto' =
			VAR _m = MAXX ( CROSSJOIN ( ALLSELECTED ( 'Técnicos'[Técnico] ), ALLSELECTED ( Registros[Puesto] ) ), [Registros] )
			RETURN
			    IF ( DIVIDE ( [Registros], _m ) >= 0.6, "#FFFFFF", "#0F2A44" )
		displayFolder: Formato
		lineageTag: db7eae3c-27e7-5027-9d8a-8f71f50def42

	measure 'Color calor alertas' =
			VAR _v = [Alertas]
			VAR _m = MAXX ( CROSSJOIN ( ALLSELECTED ( 'Técnicos'[Técnico] ), ALLSELECTED ( Alertas[Grupo] ) ), [Alertas] )
			VAR _r = DIVIDE ( _v, _m )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v ), "#FFFFFF", _r >= 0.6, "#F7C9C0", _r >= 0.3, "#FFE7A8", "#FFF6DD" )
		displayFolder: Formato
		lineageTag: 0463342c-1625-5066-9a74-7264089e1546

