	column 'Técnico reparador'
		dataType: string
		lineageTag: 065ef7c6-3c89-5236-8a26-d9656603efca
		summarizeBy: none
		sourceColumn: Técnico reparador

		annotation SummarizationSetBy = Automatic

	column 'Días desde reparación'
		dataType: int64
		formatString: 0
		lineageTag: 75aeb542-0ce5-598f-912e-35a45dc78932
		summarizeBy: none
		sourceColumn: Días desde reparación

		annotation SummarizationSetBy = Automatic

	partition Registros = m
		mode: import
		source =
				let
				    // ---- funciones auxiliares (ver comentarios en cada una)
				    fxClave =
				        // Texto comparable: MAYÚSCULAS, sin tildes, sin espacios duros/saltos de línea y con espacios simples
				        (v as any) as nullable text =>
				        let
				            Texto =
				                if v = null then null
				                else if Value.Is(v, type number) then Number.ToText(v, "0", "en-US")
				                else if Value.Is(v, type date) or Value.Is(v, type datetime) then Date.ToText(Date.From(v), [Format = "dd/MM/yyyy"])
				                else Text.From(v),
				            Pares = {{"Á", "A"}, {"À", "A"}, {"Ä", "A"}, {"Â", "A"}, {"É", "E"}, {"È", "E"}, {"Ë", "E"}, {"Ê", "E"},
				                {"Í", "I"}, {"Ì", "I"}, {"Ï", "I"}, {"Î", "I"}, {"Ó", "O"}, {"Ò", "O"}, {"Ö", "O"}, {"Ô", "O"},
				                {"Ú", "U"}, {"Ù", "U"}, {"Ü", "U"}, {"Û", "U"}, {"Ñ", "N"}, {"Ç", "C"}},
				            Mayus = if Texto = null then null else Text.Upper(Texto),
				            SinTildes = if Mayus = null then null else List.Accumulate(Pares, Mayus, (s, p) => Text.Replace(s, p{0}, p{1})),
				            // separadores raros -> espacio; después se descarta todo lo que no sea ASCII imprimible
				            Espacios = if SinTildes = null then null
				                else Text.Combine(Text.SplitAny(SinTildes, "#(00A0)#(cr)#(lf)#(tab)"), " "),
				            Ascii = if Espacios = null then null else Text.Select(Espacios, {" ".."~"}),
				            Limpio = if Ascii = null then null else Text.Combine(List.Select(Text.Split(Ascii, " "), each _ <> ""), " ")
				        in
				            if Limpio = null or Limpio = "" then null else Limpio,
				    fxOriginal =
				        // Valor tal cual se cargó en el Excel, como texto (para el control de calidad)
				        (v as any) as nullable text =>
				            if v = null then null
				            else if Value.Is(v, type date) or Value.Is(v, type datetime) then Date.ToText(Date.From(v), [Format = "dd/MM/yyyy"])
				            else if Value.Is(v, type number) then
				                (if Number.Round(v) = v then Number.ToText(v, "0", "en-US") else Number.ToText(v, null, "en-US"))
				            else let t = Text.Trim(Text.From(v)) in if t = "" then null else t,
				    fxFecha =
				        // Interpreta una fecha cargada como fecha, número de serie de Excel o texto ("21/1", "22-1", "28/05/2026")
				        (v as any) as record =>
				        let
				            Vacio = [Fecha = null, Dia = null, Mes = null, Texto = false, Parcial = false, Ilegible = false],
				            Resultado =
				                if v = null then Vacio
				                else if Value.Is(v, type date) then Vacio & [Fecha = v]
				                else if Value.Is(v, type datetime) then Vacio & [Fecha = Date.From(v)]
				                else if Value.Is(v, type datetimezone) then Vacio & [Fecha = Date.From(DateTimeZone.RemoveZone(v))]
				                else if Value.Is(v, type number) then
				                    (if v >= 1 and v < 2958466 then Vacio & [Fecha = Date.From(v)] else Vacio & [Ilegible = true])
				                else
				                    let
				                        t = Text.Trim(Text.Replace(Text.From(v), "#(00A0)", " ")),
				                        Partes = List.Select(Text.SplitAny(t, "/-. "), each _ <> ""),
				                        Numeros = List.Transform(Partes, each try Number.From(_, "en-US") otherwise null),
				                        TodoNum = List.Count(Partes) >= 2 and List.Count(Partes) <= 3
				                            and List.NonNullCount(Numeros) = List.Count(Partes)
				                            and List.AllTrue(List.Transform(Partes, each Text.Length(_) <= 4)),
				                        D = if TodoNum then Numeros{0} else null,
				                        M = if TodoNum then Numeros{1} else null,
				                        A0 = if TodoNum and List.Count(Numeros) = 3 then Numeros{2} else null,
				                        A = if A0 = null then null else if A0 < 100 then 2000 + A0 else A0
				                    in
				                        if t = "" then Vacio
				                        else if TodoNum and A <> null then
				                            (try Vacio & [Fecha = #date(A, M, D), Texto = true] otherwise Vacio & [Ilegible = true, Texto = true])
				                        else if TodoNum and D >= 1 and D <= 31 and M >= 1 and M <= 12 then
				                            Vacio & [Dia = D, Mes = M, Parcial = true, Texto = true]
				                        else
				                            (try Vacio & [Fecha = Date.From(DateTime.FromText(t, [Culture = "es-AR"])), Texto = true]
				                             otherwise Vacio & [Ilegible = true, Texto = true])
				        in
				            Resultado,
				    fxResolverFecha =
				        // Decide la fecha final de una fila. "ref" es la última fecha válida de las filas anteriores de la misma hoja.
				        // Corrige: año mal tipeado (2023 en una hoja de 2026), día/mes invertidos, fecha sin año y fecha vacía.
				        (info as record, ref as nullable date, hoy as date, minimo as date) as record =>
				        let
				            AnioRef = if ref <> null then Date.Year(ref) else Date.Year(hoy),
				            Armar = (a as number, m as number, d as number) => try #date(a, m, d) otherwise null,
				            EnRango = (f) => f <> null and f >= minimo and f <= hoy,
				            Imputar = (motivo as text) => [Fecha = ref, Alerta = if ref <> null then motivo & " (se usó la fila anterior)" else "Sin fecha"],
				            f = info[Fecha],
				            Resultado =
				                if f <> null then
				                    if EnRango(f) then [Fecha = f, Alerta = if info[Texto] then "Fecha cargada como texto" else null]
				                    else
				                        let
				                            Invertida = if f > hoy then Armar(Date.Year(f), Date.Day(f), Date.Month(f)) else null,
				                            ConAnio = Armar(AnioRef, Date.Month(f), Date.Day(f))
				                        in
				                            if EnRango(Invertida) then [Fecha = Invertida, Alerta = "Fecha con día y mes invertidos"]
				                            else if EnRango(ConAnio) then [Fecha = ConAnio, Alerta = "Fecha con año corregido"]
				                            else Imputar("Fecha fuera de rango")
				                else if info[Parcial] then
				                    let
				                        c1 = Armar(AnioRef, info[Mes], info[Dia]),
				                        c2 = if EnRango(c1) then c1 else Armar(AnioRef - 1, info[Mes], info[Dia])
				                    in
				                        if EnRango(c2) then [Fecha = c2, Alerta = "Fecha sin año (año inferido)"] else Imputar("Fecha ilegible")
				                else if info[Ilegible] then Imputar("Fecha ilegible")
				                else Imputar("Fecha vacía")
				        in
				            Resultado,
				    fxFechasTabla =
				        // Agrega [Fecha], [Alerta fecha] y [Fecha directa] a una tabla en el orden de la hoja.
				        // Las filas sin fecha (o con fecha imposible) toman la última fecha válida de las filas anteriores.
				        (t as table, columna as text, hoy as date, minimo as date) as table =>
				        let
				            ConInfo = Table.AddColumn(t, "__Info", each fxFecha(Record.Field(_, columna))),
				            ConRef = Table.AddColumn(ConInfo, "__Ref", each
				                let f = [__Info][Fecha] in if f <> null and f >= minimo and f <= hoy then f else null),
				            Relleno = Table.FillDown(ConRef, {"__Ref"}),
				            ConRes = Table.AddColumn(Relleno, "__Res", each fxResolverFecha([__Info], [__Ref], hoy, minimo)),
				            ConFecha = Table.AddColumn(ConRes, "Fecha", each [__Res][Fecha], type nullable date),
				            ConAlerta = Table.AddColumn(ConFecha, "Alerta fecha", each [__Res][Alerta], type nullable text),
				            ConDirecta = Table.AddColumn(ConAlerta, "Fecha directa", each [__Info][Fecha] <> null, type logical)
				        in
				            Table.Buffer(Table.RemoveColumns(ConDirecta, {"__Info", "__Ref", "__Res"})),
				    fxIdentificador =
				        // Clasifica lo cargado en la columna IMEI: IMEI (15 dígitos, valida dígito verificador), N° de serie Samsung,
				        // N° de orden (10 dígitos), código de pieza, modelo de producto (JBL no tiene IMEI) o valor no válido.
				        (v as any, negocio as nullable text) as record =>
				        let
				            k = fxClave(v),
				            NoDigitos = Text.Remove(Text.Combine({" ".."~"}), {"0".."9"}),
				            Base = [Identificador = k, Tipo = "No válido", Clave = null, Producto = null, Color = null, Alerta = "Identificador no válido"],
				            Luhn = (s as text) as logical =>
				                let
				                    Digitos = List.Reverse(List.Transform(Text.ToList(s), Number.From)),
				                    Suma = List.Sum(List.Transform(List.Positions(Digitos), (i) =>
				                        let n = Digitos{i} in if Number.Mod(i, 2) = 1 then (if n * 2 > 9 then n * 2 - 9 else n * 2) else n))
				                in
				                    Number.Mod(Suma, 10) = 0,
				            Resultado =
				                if k = null then [Identificador = null, Tipo = "Sin identificador", Clave = null, Producto = null, Color = null,
				                    Alerta = "Sin identificador"]
				                else
				                    let
				                        Tramos = List.Select(Text.SplitAny(k, NoDigitos), each _ <> ""),
				                        Imei = List.First(List.Select(Tramos, each Text.Length(_) = 15), null),
				                        Compacto = Text.Remove(k, {" "}),
				                        Largo = Text.Length(Compacto),
				                        NDig = Text.Length(Text.Select(Compacto, {"0".."9"})),
				                        NLet = Text.Length(Text.Select(Compacto, {"A".."Z"})),
				                        EsNum = NDig = Largo,
				                        Resto = if Text.StartsWith(Compacto, "GH") then Text.Remove(Text.Range(Compacto, 2), {"'", "-"}) else "",
				                        EsPieza = Text.Length(Resto) >= 7 and Text.Length(Resto) <= 8
				                            and Text.Length(Text.Select(Text.Start(Resto, 7), {"0".."9"})) = 7,
				                        Tokens = Text.Split(k, " "),
				                        EsProducto = List.ContainsAny(Tokens, {"JBL", "TUNE", "WAVE", "FLIP", "CHARGE", "CINEMA", "PARTYBOX", "BOOMBOX", "ENDURANCE", "QUANTUM", "ONYX", "LUNA", "ENCORE", "PULSE", "LIVE", "CLIP", "XTREME", "GO", "HARMAN", "BAR", "VIBE", "REFLECT", "SOUNDGEAR"}) or (List.Count(Tokens) >= 2 and negocio = "JBL"),
				                        Colores = [NEGRO = "NEGRO", NEGRA = "NEGRO", BLANCO = "BLANCO", BLANCA = "BLANCO", AZUL = "AZUL", ROJO = "ROJO", ROJA = "ROJO", GRIS = "GRIS", CELESTE = "CELESTE", VERDE = "VERDE", ROSA = "ROSA", VIOLETA = "VIOLETA", BEIGE = "BEIGE", CAMUFLADO = "CAMUFLADO", NARANJA = "NARANJA", PURPURA = "PURPURA", LILA = "LILA", TURQUESA = "TURQUESA", DORADO = "DORADO", PLATEADO = "PLATEADO", MENTA = "MENTA", AMARILLO = "AMARILLO"],
				                        SinMarca = List.Select(Tokens, each _ <> "JBL"),
				                        Ultimo = if List.IsEmpty(SinMarca) then null else List.Last(SinMarca),
				                        Color = if Ultimo <> null then Record.FieldOrDefault(Colores, Ultimo, null) else null,
				                        ModeloTokens = if Color <> null then List.RemoveLastN(SinMarca, 1) else SinMarca,
				                        ModeloTexto = Text.Combine(ModeloTokens, " "),
				                        Chars = Text.ToList(ModeloTexto),
				                        Separado = Text.Combine(List.Transform(List.Positions(Chars), (i) =>
				                            if i > 0 and Chars{i - 1} >= "0" and Chars{i - 1} <= "9" and Chars{i} >= "A" and Chars{i} <= "Z"
				                            then " " & Chars{i} else Chars{i})),
				                        Modelo = Text.Combine(List.Select(Text.Split(Separado, " "), each _ <> ""), " ")
				                    in
				                        if Imei <> null then
				                            [Identificador = Imei, Tipo = "IMEI", Clave = Imei, Producto = null, Color = null,
				                             Alerta = if not Luhn(Imei) then "IMEI con dígito verificador inválido"
				                                 else if k <> Imei then "Identificador con texto extra" else null]
				                        else if EsNum and List.Contains({14, 16, 17}, Largo) then
				                            Base & [Tipo = "IMEI mal cargado", Alerta = "IMEI con " & Text.From(Largo) & " dígitos"]
				                        else if EsNum and Largo = 10 then
				                            [Identificador = Compacto, Tipo = "N° de orden", Clave = "ORD-" & Compacto, Producto = null, Color = null, Alerta = null]
				                        else if EsNum then Base
				                        else if Largo = 11 and NDig + NLet = Largo and NDig > 0 and NLet > 0 then
				                            [Identificador = Compacto, Tipo = "N° de serie", Clave = "SN-" & Compacto, Producto = null, Color = null, Alerta = null]
				                        else if EsPieza then Base & [Tipo = "Código de pieza", Alerta = "Código de pieza en lugar de IMEI"]
				                        else if EsProducto then
				                            [Identificador = k, Tipo = "Modelo de producto", Clave = null,
				                             Producto = if Modelo = "" then "JBL" else "JBL " & Modelo, Color = Color, Alerta = null]
				                        else Base
				        in
				            Resultado,
				    fxCategorias =
				        // Devuelve las categorías cuyas palabras clave aparecen en el texto (ya normalizado con fxClave).
				        // Patrón "X*" = palabra que empieza con X; "X" = palabra exacta; "X Y" = frase. Las reglas exclusivas
				        // (p. ej. "Sin falla / OK") solo se aplican si ninguna otra coincidió.
				        // "reglas" viene preparada con fxPrepararReglas: se compara con operaciones nativas de listas (rápido).
				        (texto as nullable text, reglas as list) as list =>
				            if texto = null then {}
				            else
				                let
				                    NoAlfanum = Text.Remove(Text.Combine({" ".."~"}), {"0".."9", "A".."Z"}),
				                    Tokens = List.Buffer(List.Select(Text.SplitAny(texto, NoAlfanum), each _ <> "")),
				                    // todos los prefijos de cada palabra ("PANT", "PANTA"...) para cruzarlos con los patrones "X*"
				                    Prefijos = List.Buffer(List.Combine(List.Transform(Tokens, (t) => List.Transform({1..Text.Length(t)}, (n) => Text.Start(t, n))))),
				                    Frase = " " & Text.Combine(Tokens, " ") & " ",
				                    Coincide = (r as record) as logical =>
				                        List.ContainsAny(Tokens, r[Exactas]) or List.ContainsAny(Prefijos, r[Prefijos])
				                        or List.MatchesAny(r[Frases], (f) => Text.Contains(Frase, f)),
				                    Normales = List.Select(reglas, (r) => not r[Exclusiva] and Coincide(r)),
				                    Elegidas = if List.IsEmpty(Normales) then List.Select(reglas, (r) => r[Exclusiva] and Coincide(r)) else Normales
				                in
				                    List.Transform(Elegidas, each _[Categoría]),
				    fxPrepararReglas =
				        // Separa los patrones de cada regla en palabras exactas, prefijos ("X*") y frases ("X Y", "X Y*")
				        (reglas as list) as list =>
				            List.Buffer(List.Transform(reglas, (r) =>
				                let
				                    Frases = List.Select(r{2}, each Text.Contains(_, " ")),
				                    Palabras = List.Select(r{2}, each not Text.Contains(_, " "))
				                in
				                    [Categoría = r{0}, Exclusiva = r{1},
				                     Exactas = List.Buffer(List.Select(Palabras, each not Text.EndsWith(_, "*"))),
				                     Prefijos = List.Buffer(List.Transform(List.Select(Palabras, each Text.EndsWith(_, "*")), each Text.Start(_, Text.Length(_) - 1))),
				                     Frases = List.Buffer(List.Transform(Frases, each
				                         if Text.EndsWith(_, "*") then " " & Text.Start(_, Text.Length(_) - 1) else " " & _ & " "))])),
				    fxEncabezado =
				        // Busca en las primeras 8 filas la fila de encabezados que contiene todas las claves pedidas
				        (datos as table, requeridas as list, prohibidas as list) as nullable record =>
				        let
				            Filas = List.Transform(Table.ToRows(Table.FirstN(datos, 8)), (f) => List.Transform(List.FirstN(f, 60), fxClave)),
				            Ok = List.Transform(Filas, (f) => List.ContainsAll(f, requeridas) and not List.ContainsAny(f, prohibidas)),
				            Pos = List.PositionOf(Ok, true)
				        in
				            if Pos < 0 then null else [Fila = Pos, Claves = Filas{Pos}],
				    ReglasFalla =
				        {
				            {"Irreparable / destrucción", false, {"IRREPAR*", "DESTRUC*", "DESTRUCION*", "NO REPARABLE", "DISCONTINU*", "ROTO TOTAL"}},
				            {"Líquido / humedad", false, {"LIQUID*", "MOJAD*", "HUMED*", "SULFAT*", "OXID*", "AGUA"}},
				            {"Pantalla / display", false, {"PANT*", "OCTA*", "OLED*", "LCD*", "LDC*", "DISPLAY*", "TRASLU*", "TRANSLU*", "TRASNLU*", "TACTIL*", "TOUCH*", "VIDRIO*", "GLASS", "LINEAS", "MANCHA*", "PIXEL*", "IMAGEN", "PUNTOS BLANCOS", "PUNTO BLANCO"}},
				            {"Placa / electrónica", false, {"PLACA*", "SUB", "PBA", "FLEX*", "CORTO*", "MOTHER*", "CPU", "BOARD", "RF", "THERMISTOR*", "RESOLDAD*", "SOLDAD*"}},
				            {"Batería", false, {"BAT", "BATE*", "BATT*", "BATERI*", "HINCHAD*", "ENVEJECID*", "CONDICION"}},
				            {"Tapa / carcasa / marco", false, {"TAPA*", "CARCAS*", "CARCAZ*", "MARCO*", "REAR", "CHASIS", "DECO*", "DOBLAD*"}},
				            {"Adhesivo / prensado", false, {"ADH*", "ADES*", "PRENS*", "REPRENS*", "DESPEG*"}},
				            {"Software / cuenta", false, {"SOFT*", "CUENTA*", "GOOGLE", "FRP", "DESBLOQ*", "REESCRIT*", "NVF", "FLASH*", "ACT", "ACTUALIZ*", "HARD RESET", "BLOQUEAD*", "FENRIR"}},
				            {"Audio", false, {"AURI*", "PARLANTE*", "MICROF*", "MIC", "SONIDO", "AUDIO", "ALTAVOZ*", "BUZZER", "SPEAKER*", "RECEIVER", "SUENA*", "A DERECHO", "A IZQUIERDO", "FALLA DERECHO", "FALLA IZQUIERDO"}},
				            {"No enciende / carga", false, {"NO ENCIEND*", "NO PRENDE*", "NO CARGA*", "PIN DE CARGA", "CONECTOR*", "APAGA*", "REINICIA*"}},
				            {"Cámara / sensores / botones", false, {"CAMARA*", "HUELLA*", "SENSOR*", "BOTON*", "VIBRA*", "LENTE*", "PROXIMIDAD", "SPEN", "S PEN"}},
				            {"Señal / conectividad", false, {"SENAL*", "WIFI", "BLUETOOTH", "ANTENA*", "SIM", "RED", "NFC"}},
				            {"Cosmético", false, {"RAYAD*", "RAYA*", "RAYON*", "GOLPE*", "DESPINT*", "ESTETIC*", "COSMET*", "MARCAS"}},
				            {"Caja / embalaje / accesorios", false, {"CAJA*", "FUNDA*", "EMBALAJE*", "BLISTER*", "CABLE*", "ACCESORIO*", "ESTUCHE*", "ALMOHADILLA*", "TIRA", "USB"}},
				            {"Limpieza", false, {"LIMPIEZA*", "LIMPIO"}},
				            {"Espera de partes", false, {"ESPERA DE PA*", "ESPERA DE REPUESTO*", "PENDIENTE DE PARTE*", "PEDIDO DE PA*", "PEDIR PARTE*", "COMPRA DE PARTE*", "PARTES FALTANTE*", "FALTANTE DE PARTE*", "FALTA DE PARTE*", "PIDEN PARTE*", "SE PIDE*", "ASIGNACION DE PARTE*", "CARGA DE PARTE*"}},
				            {"Retrabajo por FAIL", false, {"REPARO FAIL", "RETRABAJO*", "REPROCES*", "RE PROCESADO"}},
				            {"Presupuesto / cliente", false, {"PPTO*", "PRESUPUESTO*", "DESISTE*", "RECHAZAD*"}},
				            {"Administrativo / etiquetas", false, {"ETIQUETA*", "IQC", "SPEEDUP", "GSPN"}},
				            {"Validación de scrap", false, {"VALIDACION*"}},
				            {"Sin falla / OK", true, {"OK", "SIN FALLA*", "NO PRESENTA FALLA*", "FUNCIONA*", "REPARO COMPLETO", "REPARABLE", "NO VERIFICA FALLA*"}}
				        },
				    ReglasPrograma =
				        {
				            {"Assurant", false, {"ASSU*", "ASURANT*"}},
				            {"Samsung Care", false, {"SMS CARE", "SAMSUNG CARE"}},
				            {"Movistar", false, {"MOVISTAR*"}},
				            {"Inshop", false, {"INSHOP*", "IN SHOP*"}},
				            {"Zelucash", false, {"ZELUCASH*", "ZLCS"}},
				            {"Nimasa", false, {"NIMASA"}},
				            {"Harvesting", false, {"HARDVESTING*", "HARVESTING*"}}
				        },
				
				    // ================================================================================================
				    // Un registro por equipo procesado por un técnico. Se unen TODAS las hojas por técnico (se detectan
				    // solas: alcanza con que tengan los encabezados "Fecha Procesado" y "Puesto", así que una hoja nueva
				    // se suma sin tocar nada). Se leen las hojas, no las tablas de Excel, porque las tablas no cubren
				    // todas las filas cargadas.
				    // ================================================================================================
				    Hoy = Date.From(DateTime.LocalNow()),
				    Minimo = #date(Date.Year(Hoy) - 1, 1, 1),
				    Origen = Excel.Workbook((if Text.StartsWith(RutaExcel, "http") then Web.Contents(RutaExcel) else File.Contents(RutaExcel)), null, true),
				    Hojas = Table.SelectRows(Origen, each [Kind] = "Sheet"),
				    ConEnc = Table.AddColumn(Hojas, "Enc", each try fxEncabezado([Data], {"FECHA PROCESADO", "PUESTO"}, {}) otherwise null),
				    DeTecnicos = Table.SelectRows(ConEnc, each [Enc] <> null),
				
				    // 1) Cada campo se ubica por su encabezado (con sinónimos: "Mes"/"Mes Procesado"/"0", "Negocio"/"BBTI"/"ONLINE",
				    //    "IMEI"/"N de orden", "Tecnico"/"Asignador"...) y, si no aparece, por su posición habitual
				    Sinonimos = {
				        {"Mes texto", {"MES", "MES PROCESADO", "0"}, 1},
				        {"Fecha origen", {"FECHA PROCESADO", "FECHA"}, 2},
				        {"Identificador origen", {"IMEI", "N DE ORDEN", "NRO DE ORDEN", "N DE SERIE", "SERIE", "IMEI / SERIE"}, 3},
				        {"Técnico origen", {"TECNICO", "ASIGNADOR"}, 4},
				        {"Puesto origen", {"PUESTO"}, 5},
				        {"Negocio origen", {"NEGOCIO", "UNIDAD DE NEGOCIO", "BBTI", "ONLINE", "JBL"}, 6},
				        {"Estado origen", {"ESTADO"}, 7},
				        {"Nivel origen", {"NIVEL DE REPARACION", "NIVEL REPARACION", "NIVEL"}, null},
				        {"Tipo de fail origen", {"TIPO DE FAIL", "TIPO FAIL"}, null},
				        {"OQC parcial origen", {"OQC PARCIAL"}, null},
				        {"OQC origen", {"OQC"}, null},
				        {"Observaciones origen", {"OBSERVACIONES", "OBSERVACION", "OBS"}, null}
				    },
				    Campos = List.Transform(Sinonimos, each _{0}),
				    PosCampo = (pos as list, campo as text) => pos{List.PositionOf(Campos, campo)},
				    ProcesarHoja = (hoja as text, hojaCompleta as table, enc as record) as table =>
				        let
				            // solo las primeras 40 columnas: hay hojas con el rango usado estirado hasta la columna XFD
				            datos = Table.SelectColumns(hojaCompleta, List.FirstN(Table.ColumnNames(hojaCompleta), 40)),
				            // listas en búfer: las funciones por fila de abajo las usan miles de veces
				            H = List.Buffer(List.FirstN(enc[Claves], 40)),
				            Nombres = List.Buffer(Table.ColumnNames(datos)),
				            NCols = List.Count(Nombres),
				            Buscar = (s as list) =>
				                let p = List.First(List.Select(List.Transform(s{1}, (x) => List.PositionOf(H, x)), (i) => i >= 0), null)
				                in if p <> null then p else if s{2} <> null and s{2} <= NCols then s{2} - 1 else null,
				            Pos = List.Buffer(List.Transform(Sinonimos, Buscar)),
				            PosObs = PosCampo(Pos, "Observaciones origen"),
				            // columnas sin nombre / "ColumnaN" a la derecha de Observaciones: a veces anotan ahí repuestos o modelo
				            Extras = if PosObs = null then {}
				                else List.Buffer(List.Select(List.Positions(H), (i) => i > PosObs and (H{i} = null or Text.StartsWith(H{i}, "COLUMNA")))),
				            Valor = (r as record, p as nullable number) => if p = null or p >= NCols then null else Record.Field(r, Nombres{p}),
				            TieneValor = (x) => x <> null and not (Value.Is(x, type text) and Text.Trim(Text.Replace(x, "#(00A0)", " ")) = ""),
				            Clave5 = List.Buffer(List.Transform({"Fecha origen", "Identificador origen", "Estado origen", "OQC origen", "Observaciones origen"},
				                (c) => PosCampo(Pos, c))),
				            Cuerpo = Table.AddIndexColumn(Table.Skip(datos, enc[Fila] + 1), "__Fila", enc[Fila] + 2, 1, Int64.Type),
				            // 2) Lectura por bloques de 5.000 filas: se corta tras 2 bloques seguidos sin datos. Hay hojas cuyo rango
				            //    usado llega a la fila ~1.047.000 por una celda suelta; recorrerlas fila a fila tarda decenas de minutos.
				            ColsClave = List.Buffer(List.Transform(List.Select(Clave5, (p) => p <> null and p < NCols), (p) => Nombres{p})),
				            NoVacia = (r as record) => List.NonNullCount(Record.FieldValues(Record.SelectFields(r, ColsClave))) > 0,
				            Bloque = 5000,
				            LeerBloque = (i as number) as record =>
				                let t = Table.Buffer(Table.SelectRows(Table.Range(Cuerpo, i * Bloque, Bloque), NoVacia))
				                in [i = i, t = t, fin = Table.RowCount(Table.Range(Cuerpo, i * Bloque, 1)) = 0],
				            Bloques = List.Generate(
				                () => LeerBloque(0) & [vacios = 0],
				                (s) => not s[fin] and s[vacios] < 2,
				                (s) => let b = LeerBloque(s[i] + 1) in b & [vacios = if Table.IsEmpty(b[t]) then s[vacios] + 1 else 0],
				                (s) => s[t]),
				            NoVacias = Table.Combine(Bloques),
				            // 3) Solo filas con contenido real: Mes, Técnico o Puesto solos son plantilla pre-cargada (o fórmulas
				            //    =TEXTO(fecha;"MMMM") arrastradas que dan "enero" en filas vacías)
				            //    La fecha sola tampoco alcanza: hay hojas con la fecha pre-cargada en filas futuras sin equipo.
				            ClaveContenido = List.Buffer(List.Skip(Clave5, 1)),
				            ConDatos = Table.Buffer(Table.SelectRows(NoVacias, (r) => List.MatchesAny(ClaveContenido, (p) => TieneValor(Valor(r, p))))),
				            // en búfer: los pasos siguientes recorren la tabla varias veces y sin búfer se relee el Excel cada vez
				            Filas = Table.Buffer(Table.FromRecords(List.Transform(Table.ToRecords(ConDatos), (r) =>
				                Record.FromList(List.Transform(Pos, (p) => Valor(r, p)), Campos)
				                & [#"Fila Excel" = r[__Fila],
				                   #"Nota adicional" = List.First(List.Select(List.Transform(Extras, (i) => fxClave(Valor(r, i))),
				                       (x) => x <> null and Text.Length(Text.Select(x, {"0".."9", " "})) < Text.Length(x)), null)]),
				                Campos & {"Fila Excel", "Nota adicional"})),
				            // 3) Fechas: en el orden de la hoja; las vacías/imposibles toman la de la fila anterior
				            ConFecha = fxFechasTabla(Filas, "Fecha origen", Hoy, Minimo)
				        in
				            Table.AddColumn(ConFecha, "Hoja", each hoja, type text),
				    Procesadas = Table.AddColumn(DeTecnicos, "Filas", each ProcesarHoja([Name], [Data], [Enc])),
				    Union = Table.Combine(List.Buffer(Procesadas[Filas])),
				    ConId = Table.Buffer(Table.AddIndexColumn(Union, "ID", 1, 1, Int64.Type)),
				
				    // 4) Homologación de cada campo
				    MesesTexto = [ENERO = 1, FEBRERO = 2, MARZO = 3, ABRIL = 4, MAYO = 5, JUNIO = 6, JULIO = 7, AGOSTO = 8,
				        SEPTIEMBRE = 9, SETIEMBRE = 9, OCTUBRE = 10, NOVIEMBRE = 11, DICIEMBRE = 12, JANUARY = 1, FEBRUARY = 2,
				        MARCH = 3, APRIL = 4, MAY = 5, JUNE = 6, JULY = 7, AUGUST = 8, SEPTEMBER = 9, OCTOBER = 10, NOVEMBER = 11, DECEMBER = 12],
				    NoSonNegocio = {"REPARADOR", "DIAGNOSTICO", "OQC", "PRENSADO", "REPARADO", "SCRAP", "PENDIENTE", "SIN REPARAR"},
				    Niveles = {"Nivel 0 · Software / NVF", "Nivel 1 · Ajuste mecánico", "Nivel 2 · Cambio de piezas", "Nivel 3 · Cambio de pantalla"},
				    APuesto = (k) =>
				        if k = null then "Sin puesto"
				        else if Text.StartsWith(k, "REPARAD") then "Reparador"
				        else if Text.StartsWith(k, "DIAG") then "Diagnóstico"
				        else if Text.StartsWith(k, "OQC") then "OQC"
				        else if Text.StartsWith(k, "PRENS") then "Prensado"
				        else if Text.StartsWith(k, "ASIG") then "Asignación de partes"
				        else "No válido",
				    AEstado = (k) =>
				        if k = null then "Sin estado"
				        else if Text.Contains(k, "SIN REP") then "Sin reparar"
				        else if Text.StartsWith(k, "REPARAD") and k <> "REPARADOR" then "Reparado"
				        else if Text.Contains(k, "CRAP") then "Scrap"
				        else if Text.StartsWith(k, "PEND") then "Pendiente"
				        else "No válido",
				    ANivel = (k) =>
				        let
				            p = if k = null then -1 else Text.PositionOf(k, "NIVEL"),
				            Resto = if p < 0 then "" else Text.Trim(Text.Range(k, p + 5)),
				            d = if Resto = "" then null else Text.Start(Resto, 1)
				        in
				            if d <> null and d >= "0" and d <= "3" then Number.From(d) else null,
				    AOqc = (k) =>
				        if k = null then null
				        else if Text.Contains(k, "FAIL") then "FAIL"
				        else if Text.Contains(k, "PASS") then "PASS"
				        else if Text.Contains(k, "SCRAP") then "Validación scrap"
				        else null,
				    ClaveNombre = (t) => let k = fxClave(t) in if k = null then null else Text.Combine(List.Sort(Text.Split(k, " ")), " "),
				    TextoVisible = (v) =>
				        if v = null then null
				        else let t = Text.Combine(List.Select(Text.SplitAny(Text.From(v), " #(00A0)#(cr)#(lf)#(tab)"), each _ <> ""), " ")
				        in if t = "" then null else t,
				    Limpiar = (r as record) as record =>
				        let
				            kPuesto = fxClave(r[Puesto origen]),
				            kEstado = fxClave(r[Estado origen]),
				            kNegocio = fxClave(r[Negocio origen]),
				            kMes = fxClave(r[Mes texto]),
				            Puesto = APuesto(kPuesto),
				            Estado = AEstado(kEstado),
				            Negocio = if kNegocio = null then "Sin negocio" else if List.Contains(NoSonNegocio, kNegocio) then "No válido" else kNegocio,
				            Nivel = ANivel(fxClave(r[Nivel origen])),
				            Oqc = AOqc(fxClave(r[OQC origen])),
				            Id = fxIdentificador(r[Identificador origen], Negocio),
				            Obs = TextoVisible(r[Observaciones origen]),
				            MesNum = if kMes = null then null else Record.FieldOrDefault(MesesTexto, kMes, null),
				            AlertaFecha = r[Alerta fecha],
				            CalidadFecha =
				                if AlertaFecha = null then "Original"
				                else if AlertaFecha = "Fecha cargada como texto" then "Original (texto)"
				                else if AlertaFecha = "Sin fecha" then "Sin fecha"
				                else if Text.Contains(AlertaFecha, "fila anterior") then "Imputada"
				                else "Corregida",
				            kTecnico = ClaveNombre(r[Técnico origen]),
				            Alertas = List.RemoveNulls({
				                AlertaFecha,
				                Id[Alerta],
				                if Puesto = "Sin puesto" then "Puesto vacío" else if Puesto = "No válido" then "Puesto no válido" else null,
				                if Estado = "No válido" then "Estado no válido"
				                    else if Estado = "Sin estado" and List.Contains({"Reparador", "Diagnóstico"}, Puesto) then "Estado vacío" else null,
				                if Negocio = "Sin negocio" then "Negocio vacío" else if Negocio = "No válido" then "Negocio no válido" else null,
				                if Puesto = "Reparador" and Estado = "Reparado" and Nivel = null then "Reparado sin nivel de reparación" else null,
				                if Puesto = "OQC" and Oqc = null then "OQC sin resultado" else null,
				                if MesNum <> null and r[Fecha directa] and r[Fecha] <> null and MesNum <> Date.Month(r[Fecha])
				                    then "Mes no coincide con la fecha" else null,
				                if kTecnico <> null and kTecnico <> ClaveNombre(r[Hoja]) then "Técnico distinto a la hoja" else null})
				        in
				            [Fecha = r[Fecha], #"Calidad fecha" = CalidadFecha, Técnico = r[Hoja], Puesto = Puesto, Estado = Estado,
				             Negocio = Negocio, #"Nivel de reparación" = if Nivel = null then "Sin nivel" else Niveles{Nivel},
				             #"Resultado OQC" = Oqc,
				             #"OQC parcial" = let k = fxClave(r[OQC parcial origen]) in
				                 if k = null then null else if Text.Contains(k, "REVISION") then "En revisión" else Text.Proper(k),
				             #"Tipo de fail" = let k = fxClave(r[Tipo de fail origen]) in if k = null then null else Text.Proper(k),
				             Identificador = Id[Identificador], #"Tipo de identificador" = Id[Tipo], #"Clave equipo" = Id[Clave],
				             Producto = Id[Producto], #"Color producto" = Id[Color],
				             Observación = Obs, #"Texto análisis" = fxClave(Text.Combine(List.RemoveNulls({Obs, r[Nota adicional]}), " ")),
				             #"Fecha original" = fxOriginal(r[Fecha origen]), #"Identificador original" = fxOriginal(r[Identificador origen]),
				             #"Puesto original" = fxOriginal(r[Puesto origen]), #"Estado original" = fxOriginal(r[Estado origen]),
				             #"Negocio original" = fxOriginal(r[Negocio origen]), #"Mes original" = fxOriginal(r[Mes texto]),
				             AlertasLista = Alertas]
				    ,
				    CamposLimpios = {"Fecha", "Calidad fecha", "Técnico", "Puesto", "Estado", "Negocio", "Nivel de reparación", "Resultado OQC",
				        "OQC parcial", "Tipo de fail", "Identificador", "Tipo de identificador", "Clave equipo", "Producto", "Color producto",
				        "Observación", "Texto análisis", "Fecha original", "Identificador original", "Puesto original", "Estado original",
				        "Negocio original", "Mes original", "AlertasLista"},
				    ConLimpio = Table.AddColumn(ConId, "L", each Limpiar(_)),
				    Base = Table.SelectColumns(ConLimpio, {"ID", "Hoja", "Fila Excel", "Nota adicional", "L"}),
				    // en búfer: se usa dos veces (textos distintos y unión) y así el Excel se lee una sola vez
				    Expandido = Table.Buffer(Table.ExpandRecordColumn(Base, "L", CamposLimpios)),
				
				    // 5) Categorías de falla y programa/cliente a partir del texto libre (se calcula una vez por texto distinto)
				    Textos = Table.Distinct(Table.SelectColumns(Expandido, {"Texto análisis"})),
				    ReglasFallaPrep = fxPrepararReglas(ReglasFalla),
				    ReglasProgramaPrep = fxPrepararReglas(ReglasPrograma),
				    // columnas ya resueltas por texto distinto y unión plana (evita tablas anidadas por fila)
				    TextosCat = Table.Buffer(Table.FromRecords(List.Transform(Table.ToRecords(Textos), (r) =>
				        let
				            t = r[Texto análisis],
				            l = fxCategorias(t, ReglasFallaPrep),
				            p = List.First(fxCategorias(t, ReglasProgramaPrep), null)
				        in
				            [#"__Texto" = t,
				             #"Categorías falla" = if List.IsEmpty(l) then null else Text.Combine(l, "|"),
				             #"Categoría principal" = if not List.IsEmpty(l) then l{0} else if t = null then "Sin observación" else "Sin falla especificada",
				             Programa = p ?? "Sin especificar"]),
				        {"__Texto", "Categorías falla", "Categoría principal", "Programa"})),
				    Unido = Table.Join(Expandido, "Texto análisis", TextosCat, "__Texto", JoinKind.LeftOuter),
				    // por si la unión no empareja textos vacíos (null)
				    SinNulos = Table.TransformColumns(Table.RemoveColumns(Unido, {"__Texto"}), {
				        {"Categoría principal", each _ ?? "Sin observación", type text}, {"Programa", each _ ?? "Sin especificar", type text}}),
				    Buffer = Table.Buffer(SinNulos),
				
				    // 6) Cruce por equipo (IMEI/serie): N° de reparación, resultado del control posterior (OQC/prensado),
				    //    días desde el diagnóstico, técnico que reparó lo que llega a control y posibles duplicados
				    Eventos = Table.SelectRows(Table.SelectColumns(Buffer, {"ID", "Clave equipo", "Fecha", "Técnico", "Puesto", "Estado", "Resultado OQC"}),
				        each [Clave equipo] <> null and [Fecha] <> null),
				    Cruzar = (t as table) as table =>
				        let
				            F = List.Buffer(Table.ToRecords(Table.Sort(t, {{"Fecha", Order.Ascending}, {"ID", Order.Ascending}}))),
				            EsRep = (r) => r[Puesto] = "Reparador" and r[Estado] = "Reparado",
				            Reps = List.Buffer(List.Select(F, EsRep)),
				            IdsReps = List.Buffer(List.Transform(Reps, each [ID])),
				            Ctrl = List.Buffer(List.Select(F, each [Resultado OQC] <> null)),
				            Diags = List.Buffer(List.Select(F, each [Puesto] = "Diagnóstico")),
				            Fila = (i as number) as record =>
				                let
				                    r = F{i},
				                    Dup = List.MatchesAny(List.FirstN(F, i), (x) => x[Técnico] = r[Técnico] and x[Fecha] = r[Fecha]
				                        and x[Puesto] = r[Puesto] and x[Estado] = r[Estado]),
				                    NRep = if EsRep(r) then List.PositionOf(IdsReps, r[ID]) + 1 else null,
				                    Sig = if NRep <> null and NRep < List.Count(Reps) then Reps{NRep} else null,
				                    Ventana = if NRep = null then {}
				                        else List.Select(Ctrl, (c) => c[Fecha] >= r[Fecha] and (Sig = null or c[Fecha] < Sig[Fecha] or Sig[Fecha] = r[Fecha])),
				                    Resultado =
				                        if NRep = null then null
				                        else if List.IsEmpty(Ventana) then "Sin control registrado"
				                        else if List.MatchesAny(Ventana, each [Resultado OQC] = "FAIL") then "FAIL"
				                        else if List.MatchesAny(Ventana, each [Resultado OQC] = "PASS") then "PASS"
				                        else "Validación scrap",
				                    DiagPrevios = if NRep = null then {} else List.Select(Diags, (d) => d[Fecha] <= r[Fecha]),
				                    RepPrevias = if r[Resultado OQC] = null then {} else List.Select(Reps, (x) => x[Fecha] <= r[Fecha] and x[ID] <> r[ID]),
				                    UltRep = if List.IsEmpty(RepPrevias) then null else List.Last(RepPrevias)
				                in
				                    [IDx = r[ID], Dup = Dup, #"N° de reparación" = NRep, #"Resultado control posterior" = Resultado,
				                     #"Días hasta control" = if List.IsEmpty(Ventana) then null else Duration.Days(Ventana{0}[Fecha] - r[Fecha]),
				                     #"Días desde diagnóstico" = if List.IsEmpty(DiagPrevios) then null else Duration.Days(r[Fecha] - List.Last(DiagPrevios)[Fecha]),
				                     #"Técnico reparador" = if UltRep = null then null else UltRep[Técnico],
				                     #"Días desde reparación" = if UltRep = null then null else Duration.Days(r[Fecha] - UltRep[Fecha])]
				        in
				            Table.FromRecords(List.Transform(List.Positions(F), Fila)),
				    CamposCruce = {"IDx", "Dup", "N° de reparación", "Resultado control posterior", "Días hasta control", "Días desde diagnóstico",
				        "Técnico reparador", "Días desde reparación"},
				    Grupos = Table.Group(Eventos, {"Clave equipo"}, {{"T", Cruzar, type table}}),
				    Derivados = Table.ExpandTableColumn(Table.SelectColumns(Grupos, {"T"}), "T", CamposCruce),
				    ConCruce = Table.Join(Buffer, "ID", Derivados, "IDx", JoinKind.LeftOuter),
				
				    // 7) Alertas de calidad de datos (texto separado por "|", se abre en la tabla Alertas)
				    ConDup = Table.AddColumn(ConCruce, "Posible duplicado", each if [Dup] = true then "Sí" else "No", type text),
				    ConAlertas = Table.AddColumn(ConDup, "Alertas", each
				        let l = [AlertasLista] & (if [Dup] = true then {"Posible duplicado"} else {}) in
				            if List.IsEmpty(l) then null else Text.Combine(l, "|"), type nullable text),
				    ConCant = Table.AddColumn(ConAlertas, "Cantidad de alertas", each
				        if [Alertas] = null then 0 else List.Count(Text.Split([Alertas], "|")), Int64.Type),
				    ConTiene = Table.AddColumn(ConCant, "Tiene alerta", each if [Cantidad de alertas] > 0 then "Sí" else "No", type text),
				    ConOrdenes = Table.AddColumn(Table.AddColumn(Table.AddColumn(ConTiene,
				        "Orden puesto", each List.PositionOf({"Reparador", "Diagnóstico", "Prensado", "OQC", "Asignación de partes", "Sin puesto", "No válido"}, [Puesto]) + 1, Int64.Type),
				        "Orden estado", each List.PositionOf({"Reparado", "Sin reparar", "Scrap", "Pendiente", "Sin estado", "No válido"}, [Estado]) + 1, Int64.Type),
				        "Orden nivel", each List.PositionOf(Niveles & {"Sin nivel"}, [Nivel de reparación]) + 1, Int64.Type),
				    Final = Table.SelectColumns(ConOrdenes, {"ID", "Hoja", "Fila Excel", "Fecha", "Calidad fecha", "Técnico", "Puesto", "Orden puesto",
				        "Estado", "Orden estado", "Negocio", "Nivel de reparación", "Orden nivel", "Resultado OQC", "OQC parcial", "Tipo de fail",
				        "Identificador", "Tipo de identificador", "Clave equipo", "Producto", "Color producto", "Observación", "Nota adicional",
				        "Texto análisis", "Categoría principal", "Categorías falla", "Programa", "Fecha original", "Identificador original",
				        "Puesto original", "Estado original", "Negocio original", "Mes original", "Alertas", "Cantidad de alertas", "Tiene alerta",
				        "Posible duplicado", "N° de reparación", "Resultado control posterior", "Días hasta control", "Días desde diagnóstico",
				        "Técnico reparador", "Días desde reparación"}),
				    Tipos = Table.TransformColumnTypes(Final, {
				        {"ID", Int64.Type}, {"Hoja", type text}, {"Fila Excel", Int64.Type}, {"Fecha", type date}, {"Calidad fecha", type text},
				        {"Técnico", type text}, {"Puesto", type text}, {"Estado", type text}, {"Negocio", type text},
				        {"Nivel de reparación", type text}, {"Resultado OQC", type text}, {"OQC parcial", type text}, {"Tipo de fail", type text},
				        {"Identificador", type text}, {"Tipo de identificador", type text}, {"Clave equipo", type text}, {"Producto", type text},
				        {"Color producto", type text}, {"Observación", type text}, {"Nota adicional", type text}, {"Texto análisis", type text},
				        {"Fecha original", type text}, {"Identificador original", type text}, {"Puesto original", type text},
				        {"Estado original", type text}, {"Negocio original", type text}, {"Mes original", type text},
				        {"N° de reparación", Int64.Type}, {"Resultado control posterior", type text}, {"Días hasta control", Int64.Type},
				        {"Días desde diagnóstico", Int64.Type}, {"Técnico reparador", type text}, {"Días desde reparación", Int64.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table

