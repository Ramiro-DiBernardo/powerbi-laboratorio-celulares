table Calendario
	lineageTag: c4065d8b-c03e-5d7a-8594-855517c2d72d

	column Fecha
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 9d0c51f3-352f-5bf7-bc36-4252bbef3d8a
		summarizeBy: none
		sourceColumn: Fecha

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column Año
		dataType: int64
		formatString: 0
		lineageTag: 1e6b7fbb-24dd-56be-92f3-6b2209d94584
		summarizeBy: none
		sourceColumn: Año

		annotation SummarizationSetBy = Automatic

	column 'Mes num'
